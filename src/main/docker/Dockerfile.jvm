####
# This Dockerfile packages the pre-built Quarkus application for JVM mode.
#
# Before building the container image run:
#
#   ./mvnw package -DskipTests
#
# Then build and run with:
#
#   docker build -f src/main/docker/Dockerfile.jvm -t penalty-bot .
#   docker run -i --rm -p 8080:8080 penalty-bot
#
###
FROM registry.access.redhat.com/ubi9/openjdk-21-runtime:1.24

ENV LANGUAGE='en_US:en'

# We make four distinct layers so if there are application changes the library layers can be re-used
COPY --chown=185 target/quarkus-app/lib/ /deployments/lib/
COPY --chown=185 target/quarkus-app/*.jar /deployments/
COPY --chown=185 target/quarkus-app/app/ /deployments/app/
COPY --chown=185 target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
USER 185
ENV JAVA_OPTS_APPEND="-Dquarkus.http.host=0.0.0.0 -Djava.util.logging.manager=org.jboss.logmanager.LogManager"
# Mitigation for Java4Shell (CVE-2026-114938): disable the vulnerable AVX-512 Base64
# decode intrinsic. Set via JDK_JAVA_OPTIONS so an overridden JAVA_OPTS_APPEND cannot drop it.
# Remove once the base image ships a fixed JDK (21.0.13.1 or newer).
ENV JDK_JAVA_OPTIONS="-XX:-UseBASE64Intrinsics"
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"

ENTRYPOINT [ "/opt/jboss/container/java/run/run-java.sh" ]
